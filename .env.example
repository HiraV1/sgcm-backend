PORT=3000
DATABASE_PATH=./database.sqlite

# Segredo para assinar tokens JWT — use uma string longa e aleatória (mínimo 32 caracteres)
# Geração: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Tempo de expiração do token de acesso (ex: 15m, 1h, 2h)
JWT_EXPIRES_IN=15m

# Tempo de expiração do refresh token (ex: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d
